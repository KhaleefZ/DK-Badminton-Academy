{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dk-badminton-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Set the real domain before the first deploy, e.g. "api.dkbadminton.in".
  "routes": [{ "pattern": "api.example.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "dk-badminton", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "dk-badminton-photos" },
    // Weekly database copies (src/backup.ts). Keep this bucket private: no public access, no custom domain.
    { "binding": "BACKUPS", "bucket_name": "dk-badminton-backups" }
  ],
  // Every minute: payment checks and emails take turns (src/worker.ts).
  // Sundays 03:00 IST: database backup. Must match BACKUP_CRON in src/backup.ts.
  "triggers": { "crons": ["* * * * *", "30 21 * * 6"] },
  // Counted per Cloudflare location and approximate. The database-backed login lockout is the main defence.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RESET_LIMIT", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } },
    { "name": "PUBLIC_WRITE_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "NODE_ENV": "production",
    "PAYMENT_SIMULATOR": "false",
    "ADMIN_ORIGIN": "https://admin.example.com",
    "WEBSITE_ORIGIN": "https://example.com",
    // For the weekly backup. The API token is a secret: `npx wrangler secret put BACKUP_API_TOKEN`.
    "BACKUP_ACCOUNT_ID": "",
    "BACKUP_DATABASE_ID": ""
  },
  // APP_SECRET is set with `wrangler secret put APP_SECRET`.
  "observability": { "enabled": true }
}
