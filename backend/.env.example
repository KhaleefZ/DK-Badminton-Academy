# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://localhost:5432/dk_badminton

# The admin panel's address. Only this origin may call the API with a session.
ADMIN_ORIGIN=http://localhost:5174

# The public website's address. Only this origin may use the public booking API.
WEBSITE_ORIGIN=http://localhost:5173

# true confirms website bookings without real money, for testing. The API refuses
# to start with this on when NODE_ENV=production. No gateway is connected yet.
PAYMENT_TEST_MODE=true

# Set to the number of proxies in front of the API once it is hosted.
TRUST_PROXY_HOPS=0

# Signs customers' private booking links and encrypts the saved Gmail app password.
# Required in production: a long random value, for example from `openssl rand -base64 48`.
# Changing it breaks existing links and means re-entering the app password.
# APP_SECRET=

# The email sender and WhatsApp number are set in the admin panel, under Settings.
# Until a sender is saved, development prints emails to this terminal.
